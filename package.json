{
  "name": "campusflow",
  "version": "1.0.0",
  "description": "CampusFlow - College Paperless Academic Request & Approval System",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "test:api": "node server/scripts/verify-api.js",
    "test:workflow": "node server/scripts/verify-medical-workflow.js",
    "test:cloudinary": "node server/scripts/verify-cloudinary.js",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client"
  },
  "keywords": [
    "college",
    "academic-approval",
    "paperless",
    "full-stack",
    "react",
    "express",
    "mongodb"
  ],
  "author": "CampusFlow Team",
